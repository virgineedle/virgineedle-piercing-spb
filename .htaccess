RewriteEngine On
RewriteBase /

# 1. Принудительно убираем завершающий слэш со всех URL (кроме корня /): /price/ -> /price
RewriteCond %{REQUEST_URI} ^(.+)/+$
RewriteRule ^ %1 [R=301,L]

# 2. Если запрашивается реальный существующий файл (картинка, js, css) — отдаём как есть
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 3. Чистые URL: если есть файл .html с таким именем (например price.html для /price) — отдаём его
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)$ $1.html [L]

# 4. Всё остальное отдаём в index.html (SPA-роутинг)
RewriteRule . /index.html [L]

# Сжатие для ускорения загрузки
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript
</IfModule>

# Кеширование статики
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
